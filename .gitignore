# ============================================
# Laundry Shoes App - .gitignore
# ============================================

# Dependencies (JANGAN PERNAH DI-PUSH KE GITHUB)
node_modules/
*/node_modules/
package-lock.json
# (Catatan: package-lock.json opsional, tapi node_modules WAJIB di-ignore)

# Environment variables & Secrets (SANGAT PENTING: JANGAN DI-PUSH)
.env
.env.*
!.env.example
*.env
backend/.env
mobile/.env

# Expo & React Native Build Artifacts
.expo/
*/.expo/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.kotlin/
/ios/
/android/

# Testing & Coverage
coverage/
*.lcov

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Prisma Local DBs
backend/prisma/*.db
backend/prisma/*.db-journal

# Uploads Folder (Hanya simpan struktur foldernya, bukan file upload)
backend/uploads/*
!backend/uploads/.gitkeep

# System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
