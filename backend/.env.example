# ==============================================================================
# SHOEFRESH BACKEND - KONFIGURASI WHATSAPP CLOUD API (META)
# ==============================================================================
# PERINGATAN KEAMANAN:
# File ini adalah CONTOH template konfigurasi.
# Salin file ini menjadi `.env` di folder `backend/`:
#    cp .env.example .env
# JANGAN PERNAH menaruh Access Token atau secret key di dalam aplikasi React Native!
# ==============================================================================

# Port server backend Express
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. KREDENSIAL RESMI META WHATSAPP CLOUD API
# ------------------------------------------------------------------------------
# Dapatkan kredensial ini melalui portal resmi Meta:
# 1. Buka https://developers.facebook.com/
# 2. Masuk / Buat aplikasi bertipe "Business"
# 3. Tambahkan produk "WhatsApp" ke aplikasi
# 4. Buka menu WhatsApp -> "API Setup" (Mulai Menggunakan API)
# ------------------------------------------------------------------------------

# URL dasar Meta Graph API
WHATSAPP_API_URL=https://graph.facebook.com

# Versi Meta Graph API (contoh: v21.0, v20.0)
META_API_VERSION=v21.0

# ID Nomor Telepon WhatsApp Pengirim (Phone Number ID)
# Ditemukan di halaman "API Setup" -> "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID

# Token Akses Pengguna Meta (Access Token)
# - Untuk uji coba (24 jam): Gunakan "Temporary access token" di API Setup
# - Untuk produksi: Buat System User di Business Manager dan buat "Permanent Access Token"
#   dengan izin (permission): whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_OR_TEMPORARY_ACCESS_TOKEN

# WhatsApp Business Account ID (WABA ID)
# Ditemukan di halaman "API Setup" -> "WhatsApp Business Account ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID

# ------------------------------------------------------------------------------
# 2. PENGATURAN TEMPLATE PESAN META (OUTSIDE 24-HOUR WINDOW)
# ------------------------------------------------------------------------------
# Nama template WhatsApp yang sudah disetujui (Approved) di WhatsApp Manager:
# Kategori: UTILITY
# Bahasa: Indonesian (id)
# Header: Tidak ada
# Body contoh:
# "Halo, Kak {{1}}!
#  Pesanan laundry sepatu kamu di ShoeFresh sekarang sedang {{4}}.
#  Detail pesanan:
#  • Nomor pesanan: {{2}}
#  • Layanan: {{3}}
#  • Status: {{4}}
#  Terima kasih telah menggunakan ShoeFresh!"
WHATSAPP_TEMPLATE_NAME=shoefresh_order_status_update
WHATSAPP_DEFAULT_LANGUAGE=id

# ------------------------------------------------------------------------------
# 3. MODE SIMULASI / OFFLINE DEMO (OPSIONAL)
# ------------------------------------------------------------------------------
# Jika bernilai "true" ATAU jika token di atas masih berupa placeholder, backend
# akan mencatat payload lengkap ke terminal dan mengembalikan mock respons sukses Meta
# sehingga aplikasi tetap dapat diuji coba tanpa gagal koneksi jika belum memiliki akun Meta.
WHATSAPP_SIMULATION_MODE=false
