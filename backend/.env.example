PORT=5000
NODE_ENV=development

# MySQL Database Connection String (Ganti dengan konfigurasi MySQL lokal Anda)
DATABASE_URL="mysql://root:@localhost:3306/laundry_shoes_db"

# JWT Secret for Authentication (Ganti dengan string rahasia yang kuat)
JWT_SECRET="ganti_dengan_jwt_secret_rahasia_anda_disini"
JWT_EXPIRES_IN="7d"
